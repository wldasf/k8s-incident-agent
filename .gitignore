# Secrets — never commit
**/terraform.tfvars
**/kubeconfig.yaml
*.pem
.env

# Terraform state (contains sensitive values)
**/*.tfstate
**/*.tfstate.*
**/.terraform/

# Terraform plan (Can contain sensitive values)
**/tfplan


# Python
__pycache__/
*.pyc
.venv/
venv/

# Results — keep locally, publish deliberately
results/invalid/
*.log
