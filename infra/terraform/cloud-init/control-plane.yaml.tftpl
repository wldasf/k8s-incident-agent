#cloud-config
package_update: true
packages:
  - curl
  - jq
  - open-iscsi
  - nfs-common

write_files:
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 524288

runcmd:
  - sysctl --system
  # Detect the private-network interface by the subnet it carries rather than
  # assuming a fixed name. Hetzner interface names vary by server type and
  # image, so a hardcoded name is not portable.
  - |
    for i in $(seq 1 30); do
      IFACE=$(ip -o -4 addr show | awk '$4 ~ /^10\.10\./ {print $2; exit}')
      if [ -n "$IFACE" ]; then break; fi
      sleep 2
    done
    if [ -z "$IFACE" ]; then IFACE="${private_iface}"; fi
    echo "using private interface: $IFACE" > /var/log/k3s-iface.log
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      K3S_TOKEN="${k3s_token}" \
      sh -s - server \
        --node-ip ${private_ip} \
        --advertise-address ${private_ip} \
        --flannel-iface "$IFACE" \
        --disable traefik \
        --disable servicelb \
        --write-kubeconfig-mode 644 \
        --tls-san $(curl -s -4 ifconfig.me)
  - until kubectl get nodes >/dev/null 2>&1; do sleep 5; done
  - kubectl label node $(hostname) workload-tier=control --overwrite
  - touch /var/lib/k3s-ready
