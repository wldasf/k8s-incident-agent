#cloud-config
package_update: true
packages:
  - curl
  - jq
  - open-iscsi
  - nfs-common

write_files:
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 524288

runcmd:
  - sysctl --system
  # Install k3s server. Flannel is bound to the private interface so that all
  # pod and service traffic traverses the Hetzner private network rather than
  # the public NIC. Traefik and servicelb are disabled: the study installs its
  # own ingress-free NodePort setup and does not need them.
  - |
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      K3S_TOKEN="${k3s_token}" \
      sh -s - server \
        --node-ip ${private_ip} \
        --advertise-address ${private_ip} \
        --flannel-iface ${private_iface} \
        --disable traefik \
        --disable servicelb \
        --write-kubeconfig-mode 644 \
        --tls-san $(curl -s -4 ifconfig.me)
  - until kubectl get nodes >/dev/null 2>&1; do sleep 5; done
  - kubectl label node $(hostname) workload-tier=control --overwrite
  - touch /var/lib/k3s-ready
