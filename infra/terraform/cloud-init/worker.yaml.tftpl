#cloud-config
package_update: true
packages:
  - curl
  - open-iscsi
  - nfs-common

write_files:
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 524288

  # See the control-plane template for the full rationale. In short: Hetzner
  # configures this NIC via DHCP, which races with cloud-init. Terraform knows
  # the address, so we declare it statically and override Hetzner's 50- file.
  - path: /etc/netplan/60-private-net.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          private:
            match:
              name: "en*"
            dhcp4: false
            addresses: [${private_ip}/32]
            mtu: 1450
            routes:
              - to: 10.10.0.0/16
                via: 10.10.0.1
                on-link: true

runcmd:
  - sysctl --system
  - |
    netplan apply
    for i in $(seq 1 30); do
      ip -o -4 addr show | grep -q "${private_ip}" && break
      sleep 2
    done
    if ! ip -o -4 addr show | grep -q "${private_ip}"; then
      echo "$(date -Is) FATAL: ${private_ip} never appeared" > /var/log/k3s-iface.log
      ip -brief addr show >> /var/log/k3s-iface.log
      exit 1
    fi
    echo "$(date -Is) private address ${private_ip} is up" > /var/log/k3s-iface.log
  # Bounded wait for the control plane. Previously infinite, which turned a
  # dead control plane into a 17-hour silent hang instead of a visible failure.
  - |
    JOINED=0
    for i in $(seq 1 60); do
      if curl -sk --connect-timeout 5 https://${server_ip}:6443/livez >/dev/null 2>&1; then
        JOINED=1; break
      fi
      sleep 10
    done
    if [ "$JOINED" -ne 1 ]; then
      echo "$(date -Is) FATAL: control plane ${server_ip}:6443 unreachable after 600s" >> /var/log/k3s-iface.log
      exit 1
    fi
    IFACE=$(ip -o -4 addr show | awk '$4 ~ /^10\.10\./ {print $2; exit}')
    echo "$(date -Is) using interface: $IFACE" >> /var/log/k3s-iface.log
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      K3S_URL="https://${server_ip}:6443" \
      K3S_TOKEN="${k3s_token}" \
      sh -s - agent \
        --node-ip ${private_ip} \
        --flannel-iface "$IFACE" \
        --node-label workload-tier=${node_label}
  - touch /var/lib/k3s-ready
